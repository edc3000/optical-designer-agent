# 第三方 OpenAI 兼容接口（复制为 .env 后填写）
OPTAGENT_BASE_URL=https://your-provider.example.com/v1
OPTAGENT_API_KEY=sk-...
OPTAGENT_MODEL=your-model-id
# 模型是否支持推理/思考模式（true/false）
OPTAGENT_REASONING=false
# 可选
# OPTAGENT_CONTEXT_WINDOW=128000
# OPTAGENT_MAX_TOKENS=8192
# PORT=8787
# 原项目位置（默认是同级目录 ../Optical-Layout-Designer）
# OPTOLAYOUT_ROOT=/path/to/Optical-Layout-Designer
